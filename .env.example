# OpenAI API (로컬 .env에만 실제 키 입력)
OPENAI_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=20BG-sales-agent

# Celery / Redis — BE compose.yaml의 redis 서비스(추후 Spring 캐시와 공유 예정,
# maxmemory-policy noeviction 고정 필요). 호스트에서 직접 uvicorn 실행 시 기본값 사용.
# BE compose 안에서 fastapi/worker/beat로 띄울 때는 redis://redis:6379/0 로 덮어쓴다.
# docs/speed/celery-async-development-plan.md §2.5 참고.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
