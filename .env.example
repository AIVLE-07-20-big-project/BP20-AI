SEOUL_API_KEY_SALES=
SEOUL_API_KEY_STORE=
SEOUL_API_KEY_FOOT_TRAFFIC=
SEOUL_API_KEY_EVENT=
GG_API_KEY=
KMA_API_KEY=
SEOUL_API_KEY_RESIDENT_POP=
SEOUL_API_KEY_WORK=
SEOUL_API_KEY_BIG_STORE=
SEOUL_API_KEY_SUBWAY=
SEOUL_API_KEY_SUBWAY_NAME=
SEOUL_API_KEY_BIGDATA_FLATFORM_SUBWAY=

# 신규 가맹점 영업 타겟 추천 - 소상공인시장진흥공단 상가(상권)정보 오픈API
# 반드시 "디코딩(Decoding)" 키를 넣을 것 (httpx의 params=로 넘기면 자동 인코딩되므로, 이미 인코딩된 키를 넣으면 이중 인코딩되어 인증 실패한다)
# 주의: 아래 값은 과거에 실제 키가 평문으로 커밋된 흔적(git 히스토리 4230ab8) - 재발급 권장, 새 키는 로컬 .env에만 넣을 것
PUBLIC_DATA_STORE_API_KEY=gH0XdYdiQMM4Mf71E02s8NKw1UdERSbfaRgJ3b0rsEDxAuTt2yk4h+kWgC/erVtIIl3PW9u8BBMdi+lPtVMQcw==

# 서울 열린데이터광장(data.seoul.go.kr) 인증키. app/sales_target/router.py가 SEOUL_API_KEY_SALES 등과
# 별개로 이 이름 그대로 요구한다 - 위쪽 SEOUL_API_KEY_* 들과 같은 계정 키라면 보통 같은 값을 그대로 쓰면 된다.
SEOUL_API_KEY=

# 6단계: 후보 업장 리뷰 활성도 점수(review_score)용. Places API(New) 활성화 후 발급.
# 없어도 동작은 하지만 review_score는 계속 비어있고(NaN), final_score는 성장률·유동인구·
# 유사도 3개 지표만으로 계산된다.
GOOGLE_PLACES_API_KEY=

# OpenAI API (로컬 .env에만 실제 키 입력)
OPENAI_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=20BG-sales-agent

# Celery/Redis. 로컬은 localhost, compose에서는 호스트를 redis로 설정한다.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 검색어 기반 수요 예측(네이버)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# RoBERTa 모델 로딩 hugging face
MODEL_PATH=
HF_TOKEN=

# 신규 가맹점 영업 타겟 추천 - BE 내부 API 연동
BACKEND_INTERNAL_BASE_URL=http://localhost:8080
INTERNAL_API_KEY=

# (선택, 로컬 개발용) 상권 매출/유동인구/점포수 분기별 조회 결과 캐시 디렉터리.
# 켜두면 가장 최신 분기(항상 실시간 재조회)를 제외한 과거 분기는 두 번째 실행부터 이 폴더의
# CSV를 읽고 API를 다시 안 부른다 - 배치 소요시간이 크게 줄어든다. /data/ 하위는 .gitignore에
# 이미 포함돼 있으니 data/ 아래 아무 이름이나 써도 커밋되지 않는다. 운영 환경에서는 설정하지 않는다
# (이 값이 없으면 항상 실시간 API를 쓰던 기존 동작 그대로).
SEOUL_API_QUARTER_CACHE_DIR=data/quarter_cache

# (선택, 로컬 개발 전용) 설정 시 영업 타겟 배치가 쓰는 분기 범위를 최신 N개로 강제 축소한다.
# 운영 배치에서는 절대 설정하지 말 것 - 성장률 계산창이 달라진다.
# SALES_TARGET_DEV_QUARTER_LIMIT=4
