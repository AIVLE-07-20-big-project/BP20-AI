SEOUL_API_KEY_SALES=
SEOUL_API_KEY_STORE=
SEOUL_API_KEY_FOOT_TRAFFIC=
SEOUL_API_KEY_EVENT=
GG_API_KEY=
KMA_API_KEY=
SEOUL_API_KEY_RESIDENT_POP=
SEOUL_API_KEY_WORK=
SEOUL_API_KEY_BIG_STORE=
SEOUL_API_KEY_SUBWAY=
SEOUL_API_KEY_SUBWAY_NAME=
SEOUL_API_KEY_BIGDATA_FLATFORM_SUBWAY=

# OpenAI API (로컬 .env에만 실제 키 입력)
OPENAI_API_KEY=
# 기능별 OpenAI 모델. 비워두면 코드의 기본값을 사용한다.
SALES_SUMMARY_MODEL=gpt-4.1-mini
STRATEGY_REPORT_MODEL=gpt-4.1-mini
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=20BG-sales-agent

# Celery/Redis. 로컬은 localhost, compose에서는 호스트를 redis로 설정한다.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 검색어 기반 수요 예측(네이버)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# RoBERTa 모델 로딩 hugging face
ROBERTA_MODEL_PATH=thadus2/roberta-absa-best-4class
ROBERTA_HF_TOKEN=
SPRINGBOOT_BASE_URL=
# BP20 분석 모델·데이터 저장소
HF_MODEL_REPO_ID=BAKAK/bp20-models
HF_DATASET_REPO_ID=BAKAK/bp20-data
HF_ASSET_REVISION=main
HF_AUTO_DOWNLOAD_ASSETS=true
HF_TOKEN=
AI_DATABASE_URL=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
MODEL_S3_PREFIX=models/v1
RAG_S3_PREFIX=rag/v1
DATA_S3_PREFIX=data
FEEDBACK_S3_PREFIX=feedback/v1
BANDIT_S3_PREFIX=bandit/v1
UPLOAD_S3_PREFIX=uploads/v1
CAMPAIGN_LOGS_S3_PREFIX=logs/v2
# RAG 질의 임베딩 모델도 새 환경에서 Hugging Face 캐시로 내려받는다.
RAG_ALLOW_MODEL_DOWNLOAD=true
