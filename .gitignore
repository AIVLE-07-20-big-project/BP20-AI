# 로컬 비밀정보
.env

# Python 가상환경 및 실행 캐시
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 로컬 원본·가공 데이터 및 학습 모델
/data/
/model/

# 실행 시 생성되는 분석 리포트
/reports/
/sales_report*.html
/sales_report*.json

# 커밋하지 않는 로컬 문서
/docs/

# BE 단계에서 관리하는 Docker 산출물 (아직 이 저장소에서 커밋하지 않음)
/Dockerfile
/.dockerignore

# celery beat가 로컬 실행 중 생성하는 스케줄 상태 파일
celerybeat-schedule*
